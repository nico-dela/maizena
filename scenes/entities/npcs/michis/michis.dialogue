~ start

if GameState.get_npc_talk_count("michis") >= 1:
	Michis: ¡Sanjin! MichiSaludo rápido. Meow.
	Sanjin: MichiSaludo recibido.
	Michis: Escuché que Boji busca el repollo otra vez. Meow.
	if GameState.quest_repollo_completed:
		Michis: Aunque ya se quedó en el templo. Meow.
	=> END

Michis: ¡Hey, Sanjin! ¿Me haces un MichiSaludo?
Sanjin: MichiSaludo, Michis.
Michis: Meow… eso estuvo mortal!
if GameState.quest_repollo_completed:
	Michis: El repollo sigue en el templo. Meow. Huele menos a lío.

=> END
