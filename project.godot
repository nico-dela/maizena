; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Archipiélago Maizena"
run/main_scene="res://scenes/boot/loading_screen.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
run/max_fps=20
boot_splash/bg_color=Color(0.768627, 0.305882, 0.513726, 1)
boot_splash/stretch_mode=0
config/icon="res://assets/art/ui/logos/Mascara.svg"

[autoload]

DialogueManager="*uid://c3rodes2l3gxb"
DialogueController="*uid://8f3elygc73ow"
GameState="*uid://4ywmoeftrovc"
HongosSpawner="*uid://cig0a62b7bo21"
WorldState="*res://autoload/world_state.gd"
MaizenaMeta="*res://autoload/maizena_meta.gd"
WorldMetrics="*res://autoload/world_metrics.gd"
CordobaWeather="*res://autoload/cordoba_weather.gd"
ViewportLayout="*res://autoload/viewport_layout.gd"

[dialogue_manager]

runtime/balloon_path="res://scenes/ui/dialogue_balloon/balloon.tscn"

[display]

window/size/viewport_width=1216
window/size/viewport_height=1024
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/main_scene="res://scenes/world/world.scn"
window/emulate_touch_from_mouse=true

[dotnet]

project/assembly_name="Maizena Web Game"

[editor]

movie_writer/movie_file="/mnt/Data/Videos/maizena web game.avi"
import/use_multiple_threads=false

[editor_plugins]

enabled=PackedStringArray("res://addons/YATI/plugin.cfg", "res://addons/dialogue_manager/plugin.cfg")

[filesystem]

import/blender/enabled=false

[global_group]

player=""

